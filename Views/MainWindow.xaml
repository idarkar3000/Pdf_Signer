<Window x:Class="PdfEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF Signer &amp; Studio" Height="850" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#252526"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0098FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#252526"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Gesture="Delete" Command="{Binding ClearSignCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Window.InputBindings>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="8,6" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                    <Button x:Name="BtnOpen" Content="📁 Open PDF" Style="{StaticResource NavButtonStyle}" Click="BtnOpen_Click"/>
                    <Button x:Name="BtnAddText" Content="📝 Add Text" Style="{StaticResource NavButtonStyle}" Click="BtnAddText_Click" IsEnabled="False"/>
                    <Button x:Name="BtnSign" Content="✍️ Draw Signature" Style="{StaticResource NavButtonStyle}" Click="BtnSign_Click" IsEnabled="False"/>
                    <Button x:Name="BtnClearSign" Content="🗑️ Clear Signature" Style="{StaticResource NavButtonStyle}" Click="BtnClearSign_Click" IsEnabled="False"/>
                    <Button x:Name="BtnSave" Content="💾 Save PDF" Style="{StaticResource PrimaryButtonStyle}" Click="BtnSave_Click" IsEnabled="False"/>
                </StackPanel>

                <Rectangle Width="1" Height="22" Fill="#444" Margin="0,0,15,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                    <Button x:Name="BtnUndoPdf" Content="↩️ Undo" ToolTip="Undo (Ctrl+Z)" Style="{StaticResource NavButtonStyle}" Click="BtnUndoPdf_Click" IsEnabled="False"/>
                    <Button x:Name="BtnRedoPdf" Content="↪️ Redo" ToolTip="Redo (Ctrl+Y)" Style="{StaticResource NavButtonStyle}" Click="BtnRedoPdf_Click" IsEnabled="False"/>
                </StackPanel>

                <Rectangle Width="1" Height="22" Fill="#444" Margin="0,0,15,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
                    <Button x:Name="BtnPrevPage" Content="◀" Style="{StaticResource NavButtonStyle}" Click="BtnPrevPage_Click" IsEnabled="False" Width="30"/>
                    <TextBox x:Name="TxtCurrentPage" Text="1" Width="38" Background="#1E1E1E" Foreground="White" BorderBrush="#3E3E42"
                             TextAlignment="Center" VerticalAlignment="Center" KeyDown="TxtCurrentPage_KeyDown" IsEnabled="False" Margin="4,0" Padding="2"/>
                    <TextBlock x:Name="TxtTotalPages" Text="/ 0" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="2,0,6,0" FontWeight="Bold"/>
                    <Button x:Name="BtnNextPage" Content="▶" Style="{StaticResource NavButtonStyle}" Click="BtnNextPage_Click" IsEnabled="False" Width="30"/>
                </StackPanel>

                <Rectangle Width="1" Height="22" Fill="#444" Margin="0,0,15,0"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnZoomOut" Content="➖" Style="{StaticResource NavButtonStyle}" Click="BtnZoomOut_Click" IsEnabled="False" Width="30"/>
                    <TextBlock x:Name="TxtZoomLevel" Text="100%" Foreground="#007ACC" VerticalAlignment="Center" Margin="8,0" FontWeight="Bold"/>
                    <Button x:Name="BtnZoomIn" Content="➕" Style="{StaticResource NavButtonStyle}" Click="BtnZoomIn_Click" IsEnabled="False" Width="30"/>
                    <Button x:Name="BtnZoom100" Content="1:1" Style="{StaticResource NavButtonStyle}" Click="BtnZoom100_Click" IsEnabled="False"/>
                    <Button x:Name="BtnFitPage" Content="🖼️ Fit Page" Style="{StaticResource NavButtonStyle}" Click="BtnFitPage_Click" IsEnabled="False"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- PDF Viewer -->
        <ScrollViewer Grid.Row="1" 
                      x:Name="PdfScrollViewer"
                      HorizontalScrollBarVisibility="Auto" 
                      VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                      MouseDown="PdfScrollViewer_MouseDown"
                      MouseMove="PdfScrollViewer_MouseMove"
                      MouseUp="PdfScrollViewer_MouseUp"
                      Background="#181818">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="35">
                <Canvas x:Name="PdfContainer" Background="Transparent" 
                        UseLayoutRounding="True"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        MouseMove="PdfContainer_MouseMove" 
                        MouseLeftButtonDown="PdfContainer_MouseLeftButtonDown"
                        MouseLeftButtonUp="PdfContainer_MouseLeftButtonUp">

                    <Canvas.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.6" Color="Black"/>
                    </Canvas.Effect>

                    <Canvas.LayoutTransform>
                        <ScaleTransform x:Name="PdfScaleTransform" ScaleX="1.0" ScaleY="1.0"/>
                    </Canvas.LayoutTransform>

                    <Image x:Name="PdfViewer"/>

                    <Image x:Name="SignaturePreview" 
                           Opacity="0.7" 
                           Visibility="Collapsed" 
                           Stretch="Fill"
                           Canvas.Left="-9999" Canvas.Top="-9999"
                           IsHitTestVisible="False"/>

                    <Canvas x:Name="PlacedSignatureContainer" 
                            Visibility="Collapsed" 
                            Canvas.Left="-9999" Canvas.Top="-9999">

                        <Rectangle x:Name="SignatureBorder"
                                   Stroke="#007ACC" 
                                   StrokeDashArray="3 2" 
                                   StrokeThickness="1.5"/>

                        <Image x:Name="PlacedSignatureImage" 
                               Stretch="Fill"/>

                        <Rectangle x:Name="ResizeHandle" 
                                   Width="10" Height="10" 
                                   Fill="#007ACC" 
                                   Stroke="White" 
                                   StrokeThickness="1"
                                   Cursor="SizeNWSE"
                                   MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"/>
                    </Canvas>

                    <Border x:Name="TxtPlaceholderBorder" Background="#252526" CornerRadius="8" Padding="25,15" Canvas.Left="-209" Canvas.Top="-28">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄 " FontSize="20" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPlaceholder" 
                                       Text="Drag and drop a PDF file here or click 'Open PDF'" 
                                       FontSize="15" Foreground="#CCCCCC" FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Canvas>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>