<Window x:Class="Pdf_Signer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Pdf_Signer.Views"
        Title="PDF Signer &amp; Studio" Height="850" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#F1F1F1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#252526"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0098FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#252526"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand}"/>
        <KeyBinding Gesture="Delete" Command="{Binding ClearSignatureCommand}"/>
    </Window.InputBindings>

    <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Barra de herramientas superior -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="8,6" BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                    <Button x:Name="BtnOpen" Content="📁 Open PDF" Style="{StaticResource NavButtonStyle}" Command="{Binding OpenCommand}"/>
                    <Button x:Name="BtnAddText" Content="📝 Add Text" Style="{StaticResource NavButtonStyle}" Command="{Binding AddTextCommand}"/>
                    <Button x:Name="BtnSign" Content="✍️ Draw Signature" Style="{StaticResource NavButtonStyle}" Command="{Binding SignCommand}"/>
                    <Button x:Name="BtnClearSign" Content="🗑️ Clear Signature" Style="{StaticResource NavButtonStyle}" Command="{Binding ClearSignatureCommand}"/>
                    <Button x:Name="BtnSave" Content="💾 Save PDF" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding SaveCommand}"/>
                </StackPanel>

                <Rectangle Width="1" Height="22" Fill="#444" Margin="0,0,15,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                    <Button x:Name="BtnUndoPdf" Content="↩️ Undo" ToolTip="Undo (Ctrl+Z)" Style="{StaticResource NavButtonStyle}" Command="{Binding UndoCommand}"/>
                    <Button x:Name="BtnRedoPdf" Content="↪️ Redo" ToolTip="Redo (Ctrl+Y)" Style="{StaticResource NavButtonStyle}" Command="{Binding RedoCommand}"/>
                </StackPanel>

                <Rectangle Width="1" Height="22" Fill="#444" Margin="0,0,15,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
                    <Button x:Name="BtnPrevPage" Content="◀" Style="{StaticResource NavButtonStyle}" Command="{Binding PreviousPageCommand}" Width="30"/>
                    <TextBox x:Name="TxtCurrentPage" Width="38" Background="#1E1E1E" Foreground="White" BorderBrush="#3E3E42"
                             Text="{Binding CurrentPageNumber, Mode=OneWay}"
                             TextAlignment="Center" VerticalAlignment="Center" KeyDown="TxtCurrentPage_KeyDown"
                             IsEnabled="{Binding HasDocument}" Margin="4,0" Padding="2"/>
                    <TextBlock x:Name="TxtTotalPages" Text="{Binding TotalPagesText}" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="2,0,6,0" FontWeight="Bold"/>
                    <Button x:Name="BtnNextPage" Content="▶" Style="{StaticResource NavButtonStyle}" Command="{Binding NextPageCommand}" Width="30"/>
                </StackPanel>

                <Rectangle Width="1" Height="22" Fill="#444" Margin="0,0,15,0"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnZoomOut" Content="➖" Style="{StaticResource NavButtonStyle}" Command="{Binding ZoomOutCommand}" Width="30"/>
                    <TextBlock x:Name="TxtZoomLevel" Text="{Binding ZoomText}" Foreground="#007ACC" VerticalAlignment="Center" Margin="8,0" FontWeight="Bold"/>
                    <Button x:Name="BtnZoomIn" Content="➕" Style="{StaticResource NavButtonStyle}" Command="{Binding ZoomInCommand}" Width="30"/>
                    <Button x:Name="BtnResetZoom" Content="100 %" ToolTip="Tamano de referencia" Style="{StaticResource NavButtonStyle}" Command="{Binding ResetZoomCommand}"/>
                    <Button x:Name="BtnFitPage" Content="🖼️ Fit Page" Style="{StaticResource NavButtonStyle}" Click="BtnFitPage_Click" IsEnabled="{Binding HasDocument}"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Visor del PDF -->
        <ScrollViewer Grid.Row="1"
                      x:Name="PdfScrollViewer"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                      MouseDown="PdfScrollViewer_MouseDown"
                      MouseMove="PdfScrollViewer_MouseMove"
                      MouseUp="PdfScrollViewer_MouseUp"
                      Background="#181818">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="35">
                <Canvas x:Name="PdfContainer" Background="Transparent"
                        UseLayoutRounding="True"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Width="{Binding PagePixelWidth}"
                        Height="{Binding PagePixelHeight}"
                        Cursor="{Binding CanvasCursor}"
                        MouseMove="PdfContainer_MouseMove"
                        MouseLeftButtonDown="PdfContainer_MouseLeftButtonDown"
                        MouseLeftButtonUp="PdfContainer_MouseLeftButtonUp">

                    <Canvas.Effect>
                        <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.6" Color="Black"/>
                    </Canvas.Effect>

                    <Canvas.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding ZoomScale}" ScaleY="{Binding ZoomScale}"/>
                    </Canvas.LayoutTransform>

                    <Image x:Name="PdfViewer" Source="{Binding PageImage}"/>

                    <Image x:Name="SignaturePreview"
                           Source="{Binding PreviewImage}"
                           Opacity="0.7"
                           Stretch="Fill"
                           IsHitTestVisible="False"
                           Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibility}}"
                           Canvas.Left="{Binding PreviewLeft}"
                           Canvas.Top="{Binding PreviewTop}"
                           Width="{Binding PreviewWidth}"
                           Height="{Binding PreviewHeight}"/>

                    <Grid x:Name="PlacedSignatureContainer"
                          Visibility="{Binding IsSignatureVisible, Converter={StaticResource BoolToVisibility}}"
                          Canvas.Left="{Binding SignatureLeft}"
                          Canvas.Top="{Binding SignatureTop}"
                          Width="{Binding SignatureWidth}"
                          Height="{Binding SignatureHeight}">

                        <Rectangle Stroke="#007ACC"
                                   StrokeDashArray="3 2"
                                   StrokeThickness="1.5"/>

                        <Image Source="{Binding SignatureImage}" Stretch="Fill"/>

                        <Rectangle x:Name="ResizeHandle"
                                   Width="10" Height="10"
                                   Fill="#007ACC"
                                   Stroke="White"
                                   StrokeThickness="1"
                                   Cursor="SizeNWSE"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,-5,-5"
                                   MouseLeftButtonDown="ResizeHandle_MouseLeftButtonDown"/>
                    </Grid>

                    <!-- Cuadros de texto: se colocan con Canvas.Left/Top desde su ViewModel -->
                    <ItemsControl x:Name="TextStampsHost" ItemsSource="{Binding TextStamps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <views:DraggableTextBlock/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="TxtPlaceholderBorder"
                            Background="#252526"
                            CornerRadius="8"
                            Padding="25,15"
                            Canvas.Left="-209"
                            Canvas.Top="-28"
                            Visibility="{Binding IsPlaceholderVisible, Converter={StaticResource BoolToVisibility}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="Black"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄 " FontSize="20" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPlaceholder"
                                       Text="Drag and drop a PDF file here or click 'Open PDF'"
                                       FontSize="15" Foreground="#CCCCCC" FontWeight="Medium"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Canvas>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
