<Window x:Class="PdfEditor.SignatureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Draw Signature" Height="380" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding RedoCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Window.InputBindings>

    <Grid Background="#F5F5F5" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Controls -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnUndo" Content="↩️ Undo" ToolTip="Undo (Ctrl+Z)" Click="BtnUndo_Click" Padding="6,2" Margin="0,0,4,0"/>
                <Button x:Name="BtnRedo" Content="↪️ Redo" ToolTip="Redo (Ctrl+Y)" Click="BtnRedo_Click" Padding="6,2" Margin="0,0,10,0"/>
                <TextBlock Text="Draw your signature below:" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <RadioButton x:Name="RbDraw" Content="✏️ Draw" IsChecked="True" GroupName="Tool" 
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="8,4" Margin="0,0,5,0" 
                             Checked="ModeMode_Changed"/>
                <RadioButton x:Name="RbErase" Content="🧹 Eraser" GroupName="Tool" 
                             Style="{StaticResource {x:Type ToggleButton}}" Padding="8,4" 
                             Checked="ModeMode_Changed"/>
            </StackPanel>
        </DockPanel>

        <!-- Drawing Canvas -->
        <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="2" Background="White" CornerRadius="4">
            <InkCanvas x:Name="SignatureCanvas" Background="Transparent" StrokeCollected="SignatureCanvas_StrokeCollected"/>
        </Border>

        <!-- Action Buttons -->
        <DockPanel Grid.Row="2" Margin="0,15,0,0">
            <Button Content="🗑️ Clear All" Width="100" Height="30" Click="BtnClear_Click"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="❌ Cancel" Width="90" Height="30" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                <Button Content="✅ Accept" Width="90" Height="30" Background="#007ACC" Foreground="White" Click="BtnAccept_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>